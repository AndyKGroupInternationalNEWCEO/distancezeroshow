# Copy to .env.local in the website folder (git-ignored), fill in, then: node scripts/dev.js
# Only DISTANCE // ZERO keys — never the DJ Andy'K or A.D.A.M. ones.
DZ_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
DZ_SUPABASE_SECRET_KEY=sb_secret_...
DZ_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
DZ_RESEND_API_KEY=re_...
DZ_MAIL_FROM=DISTANCE // ZERO <info@distancezeroshow.com>
DZ_TEAM_EMAIL=info@distancezeroshow.com
DZ_IP_HASH_SALT=run: openssl rand -hex 32
CRON_SECRET=run: openssl rand -hex 32
